server {
    listen 80;
    server_name _;
    charset utf-8;

    root  /usr/share/nginx/html;
    index index.html;

    # Static frontend (index.html, css/, js/, data/).
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Reverse proxy to the hoploy backend. The frontend only ever calls
    # same-origin paths like /api/recommend — no CORS, no backend URL
    # baked into the JS or loaded from a separate config file.
    #
    # BACKEND_HOST / BACKEND_PORT come from this service's environment
    # (see docker-compose.yml / .env) and are substituted into this file
    # at container startup by nginx's built-in envsubst-on-templates step.
    #
    # NOTE: only variables matching NGINX_ENVSUBST_FILTER (set to "^BACKEND_"
    # in docker-compose.yml) get substituted here. Everything else — $uri,
    # $host, $remote_addr, $proxy_add_x_forwarded_for, $scheme below — are
    # nginx's own runtime variables, left untouched on purpose. Removing
    # that filter would make envsubst try to replace those too (with
    # nothing, since they aren't shell env vars) and silently break routing.
    location /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
